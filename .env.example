# Demo-only values. Do not use these credentials outside local development.
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=bankpass
POSTGRES_DB=bankdb
CSRF_SECRET=demo-only-change-this-secret
DATABASE_URL=postgres://bankuser:bankpass@localhost:5432/bankdb?sslmode=disable
SESSION_IDLE_TIMEOUT=15m
SESSION_MAX_LIFETIME=8h
MAX_TRANSFER_AMOUNT_INR=100000
# Demo-only policy: 5 login attempts per minute per IP and username.
RATE_LIMIT="5 login attempts per minute per IP+username"
PORT=8080
# Comma-separated proxy IPs/CIDRs. Empty means trust no proxy headers.
TRUSTED_PROXIES=
TRANSFER_RATE_LIMIT=10
SWAGGER_ENABLED=true
#logging , monitoring and Observavility
LOG_LEVEL=info
OTEL_SERVICE_NAME=bank-api
# Leave the endpoint empty for local dev. Set these to send data to New Relic:
# OTEL_EXPORTER_OTLP_ENDPOINT=YOUR_NEW_RELIC_ENDPOINT_HERE
# OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_NEW_RELIC_INGEST_LICENSE_KEY
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1