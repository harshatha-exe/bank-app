            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ops_username}}\",\n  \"password\": \"{{ops_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.meta && j.meta.csrfToken) {",
                  "  pm.collectionVariables.set(\"csrfToken\", j.meta.csrfToken);",
                  "}",
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "const m = setCookie.match(/session_id=([^;]+)/);",
                  "if (m) {",
                  "  pm.collectionVariables.set(\"sessionId\", m[1]);",
                  "}",
                  "pm.test(\"login succeeds\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
