                  "pm.test(\"pagination meta present\", function () { const j = pm.response.json(); pm.expect(j.meta.totalItems).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transfer by reference",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfers/{{referenceNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers",
                "{{referenceNumber}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"transfer found\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"reference matches\", function () { const j = pm.response.json(); pm.expect(j.data.referenceNumber).to.eql(pm.collectionVariables.get(\"referenceNumber\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing CSRF token is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": \"1.00\",\n  \"purpose\": \"CSRF negative check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same request without the X-CSRF-Token header. The session is still valid, so this isolates the CSRF check. No transfer is created."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rejected with 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"error code is CSRF_INVALID\", function () { const j = pm.response.json(); pm.expect(j.error.code).to.eql(\"CSRF_INVALID\"); });"
                ]
              }
            }
          ]
        }
      ]
