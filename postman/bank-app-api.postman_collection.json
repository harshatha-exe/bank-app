          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.meta && j.meta.csrfToken) {",
                  "  pm.collectionVariables.set(\"csrfToken\", j.meta.csrfToken);",
                  "}",
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "const m = setCookie.match(/session_id=([^;]+)/);",
                  "if (m) {",
                  "  pm.collectionVariables.set(\"sessionId\", m[1]);",
                  "}",
                  "pm.test(\"login succeeds\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"user returned\", function () { pm.expect(j.data.user).to.exist; });"
                ]
              }
            }
          ]
