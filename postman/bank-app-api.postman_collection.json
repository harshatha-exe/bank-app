    {
      "name": "4. Transfers",
      "item": [
        {
          "name": "Create transfer (own accounts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": \"1.00\",\n  \"purpose\": \"API collection test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Moves Rs 1.00 between demo-customer's own two seeded accounts in the disposable test DB. The idempotency key is generated fresh per run."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"transfer created\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"reference number returned\", function () { pm.expect(j.data.referenceNumber).to.match(/^TRF-/); });",
                  "pm.collectionVariables.set(\"referenceNumber\", j.data.referenceNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": \"1.00\",\n  \"purpose\": \"API collection test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Re-sends the exact same request and Idempotency-Key. Checks the replay contract (original result returned). The stronger no-double-debit guarantee is asserted by the Go integration tests (TestTransferFailureIdempotencyAndConcurrency)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"replay accepted\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"replay returns the original reference number\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.data.referenceNumber).to.eql(pm.collectionVariables.get(\"referenceNumber\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List transfers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transfers?page=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
